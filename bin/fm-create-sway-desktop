#!/usr/bin/env bash
set -euo pipefail

DESKTOP_FILE="/usr/share/wayland-sessions/swayfx.desktop"

source "$(dirname "${BASH_SOURCE[0]}")/../lib/helpers.sh"

main() {
    info "Creating swayfx.desktop for GDM..."

    if [[ -f "$DESKTOP_FILE" ]]; then
        info "swayfx.desktop already exists, skipping"
        success "Already present: $DESKTOP_FILE"
        return 0
    fi

    if sudo tee "$DESKTOP_FILE" >/dev/null <<'EOF'; then
[Desktop Entry]
Name=SwayFX
Comment=An i3-compatible Wayland compositor with effects
Exec=sway
Type=Application
DesktopNames=SwayFX
EOF
        sudo restorecon "$DESKTOP_FILE" 2>/dev/null || true
        success "Created: $DESKTOP_FILE"
        info "Restart GDM to see it in login screen: sudo systemctl restart gdm"
    else
        error "Failed to create swayfx.desktop (sudo permission issue?)"
        return 1
    fi
}

main "$@"
