#!/usr/bin/env python3
"""fm-mock-player — a fake MPRIS player for testing the SwayNC "Now Playing" tile.

Development aid only: install.sh never copies this and nothing in the system
depends on it. It registers org.mpris.MediaPlayer2.fmmock on the session bus and
cycles through three fake tracks, so the control center can be exercised on a
machine with no real media player.

Dependencies (Fedora): python3-dbus python3-gobject

    ./bin/fm-mock-player              # play until Ctrl-C
    ./bin/fm-mock-player --paused     # start paused
    ./bin/fm-mock-player --track 3    # start on the third track
    ./bin/fm-mock-player --list       # print the track list and exit
    ./bin/fm-mock-player --art [PATH] # write the generated album art PNG and exit

The player publishes album art as a data: URI holding a generated gradient, so
the Now Playing tile has a real image to lay out with no extra files involved.

Verify from another terminal:
    gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
      --method org.freedesktop.DBus.ListNames | grep -o 'org.mpris.MediaPlayer2[^"]*'
"""

import argparse
import base64
import struct
import sys
import zlib

# (title, artist, album, length in seconds)
TRACKS = [
    ("Neon Dusk", "FM Fedora", "Soundtrack for a Dark Bar", 214),
    ("Glass Corridor", "Ambient Assembly", "Long Exposure", 187),
    ("Terminal Velocity", "Kernel Panic", "Signals", 245),
]

# ── album art ────────────────────────────────────────────────────────────────
# SwayNC only draws art that the player publishes as mpris:artUrl, and it
# accepts data: URIs. So instead of shipping a PNG (or depending on Pillow), a
# 300x300 vertical gradient is encoded here with zlib: IHDR + one IDAT + IEND,
# truecolour RGB, filter type 0 on every scanline.

ART_TOP = (0x24, 0x28, 0x3B)     # == --fm-bg-alt
ART_BOTTOM = (0x7A, 0xA2, 0xF7)  # == --fm-accent


def png_gradient(width, height, top, bottom):
    raw = bytearray()
    for y in range(height):
        t = y / max(height - 1, 1)
        pixel = bytes(round(top[i] + (bottom[i] - top[i]) * t) for i in range(3))
        raw += b"\x00" + pixel * width  # 0x00 = "no filter" for this scanline

    def chunk(kind, data):
        return (
            struct.pack(">I", len(data))
            + kind
            + data
            + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
        )

    ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", ihdr)
        + chunk(b"IDAT", zlib.compress(bytes(raw), 9))
        + chunk(b"IEND", b"")
    )


ART_URL = "data:image/png;base64," + base64.b64encode(
    png_gradient(300, 300, ART_TOP, ART_BOTTOM)
).decode("ascii")

# --art writes that PNG to disk, which makes the encoder checkable without a bus
if "--art" in sys.argv[1:]:
    _argv = sys.argv[1:]
    _i = _argv.index("--art")
    _dest = _argv[_i + 1] if len(_argv) > _i + 1 else "/tmp/fm-mock-player-art.png"
    with open(_dest, "wb") as _fh:
        _fh.write(png_gradient(300, 300, ART_TOP, ART_BOTTOM))
    print(_dest)
    sys.exit(0)

# --list has to work before the dbus import: it is the one mode that is useful
# on a machine without the python bindings installed.
if {"--list", "-l"} & set(sys.argv[1:]):
    for _num, _track in enumerate(TRACKS, start=1):
        _title, _artist, _album, _length = _track
        print("{}: {} — {} ({}, {}s)".format(_num, _title, _artist, _album, _length))
    sys.exit(0)

try:
    import dbus
    import dbus.service
    import dbus.mainloop.glib
    from gi.repository import GLib
except ImportError as exc:  # pragma: no cover - dependency guard
    sys.exit(
        "fm-mock-player: missing dependency: {}\n"
        "re-run the installer (install/core/05-swaync.sh), or:\n"
        "  sudo dnf install python3-dbus python3-gobject".format(exc)
    )

BUS_NAME = "org.mpris.MediaPlayer2.fmmock"
OBJ_PATH = "/org/mpris/MediaPlayer2"
IFACE_ROOT = "org.mpris.MediaPlayer2"
IFACE_PLAYER = "org.mpris.MediaPlayer2.Player"
IFACE_PROPS = "org.freedesktop.DBus.Properties"


class MockPlayer(dbus.service.Object):
    def __init__(self, bus, start_paused=False, index=0):
        super().__init__(bus, OBJ_PATH)
        self._index = index % len(TRACKS)
        self._playing = not start_paused
        self._stopped = False
        self._base_us = 0
        self._since = GLib.get_monotonic_time()

    # ── state ────────────────────────────────────────────────────────────────

    def _length_us(self):
        return TRACKS[self._index][3] * 1_000_000

    def _position(self):
        if not self._playing:
            return self._base_us
        return min(self._base_us + (GLib.get_monotonic_time() - self._since), self._length_us())

    def _status(self):
        if self._stopped:
            return "Stopped"
        return "Playing" if self._playing else "Paused"

    def _metadata(self):
        title, artist, album, length = TRACKS[self._index]
        return dbus.Dictionary(
            {
                "mpris:trackid": dbus.ObjectPath("/org/fmfedora/track/{}".format(self._index)),
                "mpris:length": dbus.Int64(length * 1_000_000),
                "xesam:title": dbus.String(title),
                "xesam:artist": dbus.Array([dbus.String(artist)], signature="s"),
                "xesam:album": dbus.String(album),
                "mpris:artUrl": dbus.String(ART_URL),
            },
            signature="sv",
        )

    def _props(self, interface_name):
        if interface_name == IFACE_ROOT:
            return dbus.Dictionary(
                {
                    "Identity": dbus.String("fm-mock-player"),
                    "DesktopEntry": dbus.String("fm-mock-player"),
                    "CanQuit": dbus.Boolean(True),
                    "CanRaise": dbus.Boolean(False),
                    "HasTrackList": dbus.Boolean(False),
                    "SupportedUriSchemes": dbus.Array([], signature="s"),
                    "SupportedMimeTypes": dbus.Array([], signature="s"),
                },
                signature="sv",
            )
        if interface_name == IFACE_PLAYER:
            return dbus.Dictionary(
                {
                    "PlaybackStatus": dbus.String(self._status()),
                    "Metadata": self._metadata(),
                    "Position": dbus.Int64(self._position()),
                    "Rate": dbus.Double(1.0),
                    "MinimumRate": dbus.Double(1.0),
                    "MaximumRate": dbus.Double(1.0),
                    "Volume": dbus.Double(1.0),
                    "CanPlay": dbus.Boolean(True),
                    "CanPause": dbus.Boolean(True),
                    "CanSeek": dbus.Boolean(True),
                    "CanGoNext": dbus.Boolean(True),
                    "CanGoPrevious": dbus.Boolean(True),
                    "CanControl": dbus.Boolean(True),
                },
                signature="sv",
            )
        raise dbus.exceptions.DBusException(
            "no such interface: {}".format(interface_name),
            name="org.freedesktop.DBus.Error.UnknownInterface",
        )

    def _emit(self, *keys):
        props = self._props(IFACE_PLAYER)
        changed = dbus.Dictionary({k: props[k] for k in keys}, signature="sv")
        self.PropertiesChanged(
            IFACE_PLAYER, changed, dbus.Array([], signature="s")
        )

    # ── org.freedesktop.DBus.Properties ─────────────────────────────────────

    @dbus.service.method(IFACE_PROPS, in_signature="ss", out_signature="v")
    def Get(self, interface_name, property_name):
        return self._props(interface_name)[property_name]

    @dbus.service.method(IFACE_PROPS, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface_name):
        return self._props(interface_name)

    @dbus.service.method(IFACE_PROPS, in_signature="ssv")
    def Set(self, interface_name, property_name, value):
        if interface_name == IFACE_PLAYER and property_name == "Volume":
            return  # accepted and ignored
        raise dbus.exceptions.DBusException(
            "property is read-only: {}".format(property_name),
            name="org.freedesktop.DBus.Error.PropertyReadOnly",
        )

    @dbus.service.signal(IFACE_PROPS, signature="sa{sv}as")
    def PropertiesChanged(self, interface_name, changed, invalidated):
        pass

    # ── org.mpris.MediaPlayer2 ──────────────────────────────────────────────

    @dbus.service.method(IFACE_ROOT)
    def Raise(self):
        pass  # nothing to raise

    @dbus.service.method(IFACE_ROOT)
    def Quit(self):
        self.loop.quit()

    # ── org.mpris.MediaPlayer2.Player ───────────────────────────────────────

    @dbus.service.method(IFACE_PLAYER)
    def Play(self):
        self._stopped = False
        if not self._playing:
            self._playing = True
            self._since = GLib.get_monotonic_time()
            self._emit("PlaybackStatus")

    @dbus.service.method(IFACE_PLAYER)
    def Pause(self):
        if self._playing:
            self._base_us = self._position()
            self._playing = False
            self._emit("PlaybackStatus")

    @dbus.service.method(IFACE_PLAYER)
    def PlayPause(self):
        self.Pause() if self._playing else self.Play()

    @dbus.service.method(IFACE_PLAYER)
    def Stop(self):
        self._base_us = 0
        self._playing = False
        self._stopped = True
        self._emit("PlaybackStatus", "Metadata")

    @dbus.service.method(IFACE_PLAYER)
    def Next(self):
        self._switch(+1)

    @dbus.service.method(IFACE_PLAYER)
    def Previous(self):
        self._switch(-1)

    @dbus.service.method(IFACE_PLAYER, in_signature="x")
    def Seek(self, offset):
        self._base_us = max(0, self._position() + int(offset))
        self._since = GLib.get_monotonic_time()
        self.Seeked(self._position())

    @dbus.service.method(IFACE_PLAYER, in_signature="ox")
    def SetPosition(self, track_id, position):
        self._base_us = max(0, int(position))
        self._since = GLib.get_monotonic_time()
        self.Seeked(self._position())

    @dbus.service.signal(IFACE_PLAYER, signature="x")
    def Seeked(self, position):
        pass

    # ── internals ───────────────────────────────────────────────────────────

    def _switch(self, delta):
        self._index = (self._index + delta) % len(TRACKS)
        self._base_us = 0
        self._since = GLib.get_monotonic_time()
        self._stopped = False
        self._playing = True
        self._emit("Metadata", "PlaybackStatus")

    def tick(self):
        """Advance to the next track when the current one runs out."""
        if self._playing and self._position() >= self._length_us():
            self._switch(+1)
        return True  # keep the timeout alive


def main():
    parser = argparse.ArgumentParser(
        description="Fake MPRIS player for testing the SwayNC Now Playing tile."
    )
    parser.add_argument("--paused", action="store_true", help="start paused")
    parser.add_argument(
        "--track", type=int, default=1, metavar="N", help="start on track N (1-3)"
    )
    parser.add_argument("--list", action="store_true", help="print tracks and exit")
    args = parser.parse_args()

    if args.list:  # normally handled before the dbus import; kept for --help
        for i, (title, artist, album, length) in enumerate(TRACKS, start=1):
            print("{}: {} — {} ({}, {}s)".format(i, title, artist, album, length))
        return

    if not 1 <= args.track <= len(TRACKS):
        parser.error("--track must be between 1 and {}".format(len(TRACKS)))

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    player = MockPlayer(bus, args.paused, args.track - 1)
    # keep a reference: dropping the BusName unregisters the service
    bus_name = dbus.service.BusName(BUS_NAME, bus, replace_existing=True)  # noqa: F841

    GLib.timeout_add_seconds(1, player.tick)

    title, artist, _, _ = TRACKS[player._index]
    print("fm-mock-player: serving {}".format(BUS_NAME))
    print("  {} — {} ({})".format(title, artist, player._status().lower()))
    print("  Ctrl-C to stop")

    loop = GLib.MainLoop()
    player.loop = loop
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    finally:
        print("\nfm-mock-player: stopped")


if __name__ == "__main__":
    main()
