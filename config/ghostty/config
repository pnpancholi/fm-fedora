# Ghostty configuration — generated by fm-fedora
# https://ghostty.org/docs/config/reference

# Shell
shell-integration = detect

# Window
window-decoration = server
window-padding-x = 8
window-padding-y = 8

# Font
font-family = "JetBrains Mono"
font-size = 11

# Theme + Blur (10% = 0.9 opacity)
theme = "TokyoNight Night"
background-opacity = 0.9

# Performance
window-vsync = true

# Cursor
cursor-style = "block"
cursor-style-blink = true

# Scrollback
scrollback-limit = 10000000

# Keybinds: traditional Ghostty defaults