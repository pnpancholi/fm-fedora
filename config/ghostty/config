# Ghostty configuration — generated by fm-fedora
# https://ghostty.org/docs/config/reference

# Shell
shell-integration = detect

# Window
window-decorations = false
window-padding-x = 8
window-padding-y = 8

# Font
font-family = "JetBrains Mono"
font-size = 11

# Theme + Blur (10% = 0.9 opacity)
theme = "tokyo-night"
background-opacity = 0.9

# Performance
vsync = true
render-backend = "auto"

# Cursor
cursor-style = "block"
cursor-blink-rate = 500

# Scrollback
scrollback-lines = 10000

# Keybinds: traditional Ghostty defaults