// Waybar configuration — generated by fm-fedora
// https://github.com/Alexays/Waybar/wiki/Configuration

{
    "layer": "top",
    "position": "top",
    "height": 32,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["memory", "cpu", "network", "bluetooth", "pulseaudio", "battery", "tray"],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "active": "●",
            "inactive": "○",
            "urgent": "◌"
        }
    },

    "clock": {
        "format": "%H:%M",
        "format-alt": "%Y-%m-%d",
        "tooltip-format": "%A, %B %d"
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "",
        "format-disconnected": ""
    },

    "bluetooth": {
        "format": " {status}",
        "format-icons": {
            "enabled": "on",
            "disabled": "off"
        }
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "🔇",
        "format-icons": {
            "default": ["🔈", "🔉", "🔊"]
        }
    },

    "memory": {
        "format": "󰍛 {}%"
    },

    "cpu": {
        "format": " {}%"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 4
    }
}