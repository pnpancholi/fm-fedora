{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 0,
    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "tray",
        "network",
        "bluetooth",
        "pulseaudio",
        "cpu",
        "memory",
        "battery",
        "custom/notification"
    ],
    /* Waybar 0.15 has no mango/* modules: mango speaks ext-workspace-v1,
     * which Waybar exposes as ext/workspaces. Names come from mango's tag
     * presets ("1".."31"). ignore-hidden keeps only the tags in the current
     * view on the bar — the protocol carries no occupancy information, so
     * empty-vs-occupied cannot be distinguished anyway. */
    "ext/workspaces": {
        "format": "{name}",
        "ignore-hidden": true,
        "sort-by-name": true,
        "on-click": "activate",
        "on-click-right": "deactivate"
    },
    /* Clock formats are std::chrono, not strftime: a bare "%H:%M" prints
     * literally on Waybar >= 0.11. */
    "clock": {
        "format": "{:%A, %d %B %Y - %H:%M}",
        "format-alt": "{:%b %d - %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right"
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "⏸ {artist} - {title}",
        "format-stopped": "",
        "max-length": 35,
        "player-icons": {
            "default": "🎵",
            "spotify": "",
            "mpv": "▶",
            "firefox": ""
        },
        "ignored-players": [
            "chromium"
        ]
    },
    "tray": {
        "icon-size": 18,
        "spacing": 4
    },
    "network": {
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰤮",
        "interval": 10,
        "on-click": "ghostty -e nmtui",
        "on-click-right": "gnome-control-center wifi"
    },
    "bluetooth": {
        "format": "",
        "format-disconnected": "󰂲",
        "format-off": "󰂲",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "pamixer -t"
    },
    "cpu": {
        "format": " {}%",
        "interval": 5,
        "on-click": "ghostty -e btop"
    },
    "memory": {
        "format": " {}%",
        "interval": 5,
        "on-click": "ghostty -e btop"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": " {capacity}%",
        "format-plugged": "",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "states": {
            "warning": 20,
            "critical": 10
        },
        "on-click": "ghostty -e bash -c 'upower -i /org/freedesktop/UPower/devices/battery_BAT0; read -n1'",
        "on-click-right": "pavucontrol"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
