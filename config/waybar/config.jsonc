{
    "layer": "top",
    "position": "top",
    "height": 35,
    "spacing": 0,
    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "image#vicinae",
        "custom/airplane",
        "custom/dnd",
        "network",
        "bluetooth",
        "pulseaudio",
        "custom/menu"
    ],
    /* Waybar 0.15 has no mango/* modules: mango speaks ext-workspace-v1,
     * which Waybar exposes as ext/workspaces. ignore-hidden keeps only
     * tags in the current view; the protocol has no occupancy info. */
    "ext/workspaces": {
        "format": "{name}",
        "ignore-hidden": true,
        "sort-by-name": true,
        "on-click": "activate",
        "on-click-right": "deactivate"
    },
    /* Chrono formats, not strftime. Display only: no format-alt, no click,
     * no tooltip, no calendar. */
    "clock": {
        "format": "{:%A, %d %B %Y - %H:%M}",
        "tooltip": false
    },
    /* Installed by the vicinae package (hicolor 512x512/apps). If the file
     * is absent the image module hides itself, so no exec-if is needed. */
    "image#vicinae": {
        "path": "/usr/share/icons/hicolor/512x512/apps/vicinae.png",
        "size": 18,
        "tooltip": false,
        "on-click": "vicinae toggle"
    },
    /* One glyph in every state (U+F1EB) so the bar always reads the same;
     * state is carried by colour. The name follows the glyph while a link
     * is up: {essid} on wifi, {ifname} on wired -- Waybar exposes no
     * NetworkManager profile name, so the device name is the closest. */
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " {ifname}",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid}\n{signaldBm} dBm · {ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 10,
        "on-click": "sh -c '$HOME/.local/bin/fm-settings wifi'",
        "format-linked": ""
    },
    /* Same idea: one glyph, dimmed via .off / .disabled rather than a
     * different icon, so the slot never collapses. */
    "bluetooth": {
        "format": "",
        "format-disconnected": "",
        "format-off": "",
        "format-no-controller": "",
        "on-click": "sh -c '$HOME/.local/bin/fm-settings bluetooth'"
    },
    /* Mode switches, left of the radios they turn off. fm-toggle prints one
     * Waybar JSON line, so state is carried by colour like network/bluetooth:
     * primary when on, muted when off.
     *
     * interval is only a safety net for changes made elsewhere (Wi-Fi turned
     * off in Settings changes airplane state). Clicks -- from here or from the
     * control centre -- reach the bar immediately because fm-toggle pokes
     * signal 8, which is why both modules declare the same number. */
    "custom/airplane": {
        "exec": "$HOME/.local/bin/fm-toggle airplane bar",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "tooltip": true,
        "on-click": "$HOME/.local/bin/fm-toggle airplane"
    },
    "custom/dnd": {
        "exec": "$HOME/.local/bin/fm-toggle dnd bar",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "tooltip": true,
        "on-click": "$HOME/.local/bin/fm-toggle dnd"
    },
    /* Icons follow the sink port name: headphone / speaker / headset keys
     * are matched against getSinkPortName(), so they swap when you plug
     * headphones in or out. */
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "{volume}% {icon}",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "speaker": "",
            "default": ""
        },
        "tooltip-format": "{desc}",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    /* Hamburger, rightmost: opens the SwayNC control center. -sw skips
     * swaync-client waiting for the panel to appear. */
    "custom/menu": {
        "format": "",
        "tooltip": false,
        "on-click": "swaync-client -t -sw"
    }
}
