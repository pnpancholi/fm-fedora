{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,
    "modules-left": ["mango/workspaces", "mango/layout", "mango/window"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "tray", "memory", "cpu", "network", "bluetooth", "pulseaudio", "battery", "custom/notification"],

    "mango/workspaces": {
        "format": "{icon}",
        "hide-empty": true,
        "on-click": "activate",
        "on-click-right": "toggle",
        "overview-label": "OVERVIEW",
        "format-icons": {
            "active": "■",
            "inactive": "□",
            "urgent": "◌"
        }
    },

    "mango/window": {
        "format": "{}",
        "max-length": 45
    },

    "mango/layout": {
        "format": "{}"
    },

    "clock": {
        "format": "%H:%M",
        "tooltip-format": "%A, %B %d, %Y",
        "format-alt": "%Y-%m-%d",
        "on-click": "ghostty -e bash -c 'cal -3; read -n1'",
        "on-click-right": "ghostty -e bash -c 'calcurse; read -n1'"
    },

    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "⏸ {artist} - {title}",
        "format-stopped": "",
        "max-length": 35,
        "player-icons": {
            "default": "🎵",
            "spotify": "",
            "mpv": "▶",
            "firefox": ""
        },
        "ignored-players": ["chromium"]
    },

    "memory": {
        "format": " {}%",
        "interval": 5,
        "on-click": "ghostty -e btop"
    },

    "cpu": {
        "format": " {}%",
        "interval": 5,
        "on-click": "ghostty -e btop"
    },

    "network": {
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰤮",
        "interval": 10,
        "on-click": "ghostty -e nmtui",
        "on-click-right": "gnome-control-center wifi"
    },

    "bluetooth": {
        "format": "",
        "format-disconnected": "󰂲",
        "format-off": "󰂲",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "pamixer -t"
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": " {capacity}%",
        "format-plugged": "",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "warning": 20,
            "critical": 10
        },
        "on-click": "ghostty -e bash -c 'upower -i /org/freedesktop/UPower/devices/battery_BAT0; read -n1'",
        "on-click-right": "pavucontrol"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 4
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}