{
    "layer": "top",
    "position": "top",
    "height": 35,
    "spacing": 0,
    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "image#vicinae",
        "network",
        "bluetooth",
        "pulseaudio"
    ],
    /* Waybar 0.15 has no mango/* modules: mango speaks ext-workspace-v1,
     * which Waybar exposes as ext/workspaces. ignore-hidden keeps only
     * tags in the current view; the protocol has no occupancy info. */
    "ext/workspaces": {
        "format": "{name}",
        "ignore-hidden": true,
        "sort-by-name": true,
        "on-click": "activate",
        "on-click-right": "deactivate"
    },
    /* Chrono formats, not strftime. No format-alt on purpose: a click must
     * not change the format, it pops a calendar via yad instead. */
    "clock": {
        "format": "{:%A, %d %B %Y - %H:%M}",
        "on-click": "yad --calendar --undecorated --skip-taskbar --close-on-unfocus --mouse",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right"
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    /* Installed by the vicinae package (hicolor 512x512/apps). If the file
     * is absent the image module hides itself, so no exec-if is needed. */
    "image#vicinae": {
        "path": "/usr/share/icons/hicolor/512x512/apps/vicinae.png",
        "size": 18,
        "tooltip": false,
        "on-click": "vicinae toggle"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid}\n{signaldBm} dBm · {ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 10,
        "on-click": "ghostty -e nmtui"
    },
    "bluetooth": {
        "format": "",
        "format-disconnected": "󰂲",
        "format-off": "󰂲",
        "format-no-controller": "",
        "on-click": "ghostty -e bluetoothctl"
    },
    /* Icons follow the sink port name: headphone / speaker / headset keys
     * are matched against getSinkPortName(), so they swap when you plug
     * headphones in or out. */
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "{volume}% {icon}",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "speaker": "",
            "default": ""
        },
        "tooltip-format": "{desc}",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }
}
