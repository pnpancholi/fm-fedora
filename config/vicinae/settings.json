// fm-fedora — Vicinae settings
//
// Written to ~/.config/vicinae/settings.json by install/core/04-desktop-env.sh.
// Vicinae merges this over its defaults and rewrites the file when settings are
// changed in the GUI, so keep this file in sync with GUI changes.
//
// Shape follows Vicinae v0.17+ (the config overhaul): launcher window keys live
// under "launcher_window"; the old "window"/"renderer"/"vsync"/"server" keys are
// no longer read.

{
  "$schema": "https://vicinae.com/schemas/config.json",
  "imports": [],

  // Font (match Ghostty: JetBrains Mono 11)
  "font": {
    "normal": { "family": "JetBrains Mono", "size": 11 }
  },

  // Theme — monochrome palette shared with the Noctalia shell
  // (config/vicinae/themes/monochrome.toml)
  "theme": {
    "dark": { "name": "monochrome", "icon_theme": "auto" },
    "light": { "name": "monochrome", "icon_theme": "auto" }
  },

  // Window (match Ghostty: 8px padding, 0.9 opacity, rounded)
  "launcher_window": {
    "opacity": 0.9,
    "rounding": 10,
    "material": "auto",
    "blur": { "enabled": true }
  }
}
